# Non-secret release configuration. Source locally or set in CI.
SPACEMENDER_TEAM_ID=ABCDE12345
SPACEMENDER_SIGNING_IDENTITY=Developer ID Application

# Name only. Store notarization credentials in the login keychain:
# xcrun notarytool store-credentials spacemender-notary
SPACEMENDER_NOTARY_PROFILE=spacemender-notary

# Optional output override. The default is the ignored release-artifacts/.
# SPACEMENDER_RELEASE_ROOT=/absolute/path/to/release-output
